<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Portal users (B2B customers) only read objectives shared with their company,
        once they are running or closed. They never write through the ORM: check-ins
        go through the portal controller, which checks the rights and uses sudo.
    -->
    <record id="okr_objective_rule_portal" model="ir.rule">
        <field name="name">Objective: shared with my company (portal)</field>
        <field name="model_id" ref="okr_scale.model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('portal_shared', '=', True), ('state', 'in', ('running', 'done')), '|', ('partner_id', 'child_of', user.commercial_partner_id.id), ('key_result_ids.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_key_result_rule_portal" model="ir.rule">
        <field name="name">Key Result: of objectives shared with my company (portal)</field>
        <field name="model_id" ref="okr_scale.model_okr_scale_key_result"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('objective_id', 'any', [('portal_shared', '=', True), ('state', 'in', ('running', 'done')), '|', ('partner_id', 'child_of', user.commercial_partner_id.id), ('key_result_ids.owner_id', '=', user.id)])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_checkin_rule_portal" model="ir.rule">
        <field name="name">Check-in: of objectives shared with my company (portal)</field>
        <field name="model_id" ref="okr_scale.model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('state', '!=', 'draft'), ('objective_id', 'any', [('portal_shared', '=', True), ('state', 'in', ('running', 'done')), '|', ('partner_id', 'child_of', user.commercial_partner_id.id), ('key_result_ids.owner_id', '=', user.id)])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_cycle_rule_portal" model="ir.rule">
        <field name="name">Cycle: of objectives shared with my company (portal)</field>
        <field name="model_id" ref="okr_scale.model_okr_scale_cycle"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('objective_ids', 'any', [('portal_shared', '=', True), ('state', 'in', ('running', 'done')), '|', ('partner_id', 'child_of', user.commercial_partner_id.id), ('key_result_ids.owner_id', '=', user.id)])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
