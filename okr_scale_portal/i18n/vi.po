#, python-format
msgid ""
"%(user)s checked in on \"%(kr)s\" from the customer portal: progress "
"%(progress).0f%%."
msgstr ""
"%(user)s đã cập nhật tiến độ \"%(kr)s\" từ cổng khách hàng: tiến độ "
"%(progress).0f%%."

#. module: okr_scale_portal
#: model:mail.template,body_html:okr_scale_portal.mail_template_okr_portal_checkin_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.owner_id.name or ''\">Customer</t>,\n"
"        <br><br>\n"
"        It is time to update the key result <strong t-out=\"object.name or ''\">20 new customers</strong>\n"
"        of the objective <strong t-out=\"object.objective_id.name or ''\">Grow revenue</strong>.\n"
"        <br>\n"
"        Current progress: <t t-out=\"'%.0f' % object.progress\">40</t>%.\n"
"        <br><br>\n"
"        <a t-att-href=\"object.objective_id.get_base_url() + object.objective_id.access_url\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"            Check in now\n"
"        </a>\n"
"        <br><br>\n"
"        Thank you,\n"
"        <br>\n"
"        <t t-out=\"object.company_id.name or ''\">DMAG</t>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Xin chào <t t-out=\"object.owner_id.name or ''\">Khách hàng</t>,\n"
"        <br><br>\n"
"        Đã đến lúc cập nhật kết quả then chốt <strong t-out=\"object.name or ''\">20 khách hàng mới</strong>\n"
"        thuộc mục tiêu <strong t-out=\"object.objective_id.name or ''\">Tăng doanh thu</strong>.\n"
"        <br>\n"
"        Tiến độ hiện tại: <t t-out=\"'%.0f' % object.progress\">40</t>%.\n"
"        <br><br>\n"
"        <a t-att-href=\"object.objective_id.get_base_url() + object.objective_id.access_url\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"            Cập nhật ngay\n"
"        </a>\n"
"        <br><br>\n"
"        Trân trọng,\n"
"        <br>\n"
"        <t t-out=\"object.company_id.name or ''\">DMAG</t>\n"
"    </p>\n"
"</div>\n"
"            "

