<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_key_result_view_form_portal" model="ir.ui.view">
        <field name="name">okr.scale.key.result.form.portal</field>
        <field name="model">okr.scale.key.result</field>
        <field name="inherit_id" ref="okr_scale.okr_key_result_view_form"/>
        <field name="arch" type="xml">
            <field name="owner_id" position="attributes">
                <attribute name="domain">['|', ('share', '=', False), ('partner_id.commercial_partner_id', '=', portal_partner_id)]</attribute>
            </field>
            <field name="owner_id" position="after">
                <field name="portal_partner_id" invisible="1"/>
                <field name="portal_reminder_date" invisible="not portal_reminder_date"/>
            </field>
        </field>
    </record>
</odoo>
