<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_key_result_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.key.result.tree</field>
        <field name="model">okr.scale.key.result</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'off_track'" decoration-warning="status == 'at_risk'" decoration-success="status == 'achieved'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="objective_id" optional="show"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="progress_method" optional="hide"/>
                <field name="start_value" optional="hide" invisible="progress_method != 'manual'"/>
                <field name="current_value" invisible="progress_method != 'manual'"/>
                <field name="target_value" invisible="progress_method != 'manual'"/>
                <field name="unit" optional="show" invisible="progress_method != 'manual'"/>
                <field name="weight" optional="hide"/>
                <field name="progress" widget="progressbar"/>
                <field name="confidence" optional="show"/>
                <field name="last_checkin_date" optional="show"/>
                <field name="status" widget="badge" decoration-success="status in ('on_track', 'achieved')"
                       decoration-warning="status == 'at_risk'" decoration-danger="status == 'off_track'"/>
                <field name="objective_state" column_invisible="True"/>
                <button name="action_checkin" type="object" string="Check-in" icon="fa-bullseye" class="btn-link"
                        invisible="objective_state != 'running'"/>
            </tree>
        </field>
    </record>

    <record id="okr_key_result_view_form" model="ir.ui.view">
        <field name="name">okr.scale.key.result.form</field>
        <field name="model">okr.scale.key.result</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_checkin" type="object" string="Check-in" class="btn-primary"
                            invisible="objective_state != 'running'"/>
                    <field name="status" widget="statusbar" statusbar_visible="on_track,at_risk,off_track,achieved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_checkins" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="checkin_count" widget="statinfo" string="Check-ins"/>
                        </button>
                        <button name="action_view_aligned_objectives" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="aligned_objective_count" widget="statinfo" string="Aligned"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sign 20 new B2B customers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="objective_id"/>
                            <field name="owner_id" widget="many2one_avatar_user" string="Accountable"/>
                            <field name="contributor_ids" widget="many2many_avatar_user" options="{'no_create': True}"/>
                            <field name="deadline"/>
                            <field name="progress_method"/>
                            <field name="weight"/>
                        </group>
                        <group>
                            <field name="metric_type" invisible="progress_method != 'manual'"/>
                            <field name="unit" invisible="progress_method != 'manual' or metric_type == 'boolean'"/>
                            <field name="start_value" invisible="progress_method != 'manual' or metric_type == 'boolean'"/>
                            <field name="target_value" invisible="progress_method != 'manual' or metric_type == 'boolean'"/>
                            <field name="current_value" readonly="1" invisible="progress_method != 'manual'"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="confidence" readonly="1"/>
                            <field name="last_checkin_date"/>
                        </group>
                    </group>
                    <div class="mb-3">
                        <field name="progress_history" widget="okr_progress_chart" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Check-ins" name="checkins">
                            <field name="checkin_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="value_before"/>
                                    <field name="new_value"/>
                                    <field name="progress_after" widget="progressbar"/>
                                    <field name="confidence"/>
                                    <field name="blockers"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Aligned Objectives" name="aligned">
                            <field name="aligned_objective_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="How is this key result measured?"/>
                        </page>
                    </notebook>
                    <field name="objective_state" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="okr_key_result_view_search" model="ir.ui.view">
        <field name="name">okr.scale.key.result.search</field>
        <field name="model">okr.scale.key.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="objective_id"/>
                <field name="owner_id"/>
                <field name="department_id"/>
                <field name="cycle_id"/>
                <filter name="my" string="My Key Results" domain="[('owner_id', '=', uid)]"/>
                <filter name="checkin_due" string="Check-in Due" domain="[('checkin_due', '=', True)]"/>
                <separator/>
                <filter name="running" string="Running" domain="[('objective_state', '=', 'running')]"/>
                <filter name="risky" string="At Risk / Off Track" domain="[('status', 'in', ('at_risk', 'off_track'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_objective" string="Objective" context="{'group_by': 'objective_id'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="okr_key_result_action" model="ir.actions.act_window">
        <field name="name">Key Results</field>
        <field name="res_model">okr.scale.key.result</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_running': 1}</field>
    </record>

    <record id="okr_key_result_action_my" model="ir.actions.act_window">
        <field name="name">My Key Results</field>
        <field name="res_model">okr.scale.key.result</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my': 1, 'search_default_running': 1}</field>
    </record>
</odoo>
