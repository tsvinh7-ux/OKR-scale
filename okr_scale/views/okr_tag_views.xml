<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_tag_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.tag.tree</field>
        <field name="model">okr.scale.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="okr_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">okr.scale.tag</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
