<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_okr" model="ir.module.category">
        <field name="name">OKR</field>
        <field name="description">Objectives and Key Results</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_okr_user" model="res.groups">
        <field name="name">User: own OKRs</field>
        <field name="category_id" ref="module_category_okr"/>
        <field name="comment">See visible OKRs, manage own individual objectives and check in on own key results.</field>
    </record>

    <record id="group_okr_manager" model="res.groups">
        <field name="name">Manager: team and department OKRs</field>
        <field name="category_id" ref="module_category_okr"/>
        <field name="implied_ids" eval="[(4, ref('group_okr_user'))]"/>
        <field name="comment">Manage objectives of managed departments and of team members, review check-ins.</field>
    </record>

    <record id="group_okr_admin" model="res.groups">
        <field name="name">Administrator: company OKRs</field>
        <field name="category_id" ref="module_category_okr"/>
        <field name="implied_ids" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manage cycles, company objectives and every OKR.</field>
    </record>

    <!-- Every employee takes part in OKRs -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_okr_user'))]"/>
    </record>

    <record id="okr_objective_rule_user_read" model="ir.rule">
        <field name="name">Objective: visible objectives</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', '|', '|', '|', '|', ('visibility', '=', 'public'), ('owner_id', '=', user.id), ('employee_id.user_id', '=', user.id), ('key_result_ids.owner_id', '=', user.id), '&amp;', ('visibility', '=', 'department'), ('department_id.member_ids.user_id', '=', user.id), '|', ('department_id.okr_manager_user_ids', 'in', [user.id]), ('employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_objective_rule_user_own" model="ir.rule">
        <field name="name">Objective: own objectives</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_objective_rule_user_unlink" model="ir.rule">
        <field name="name">Objective: delete own drafts</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['&amp;', ('state', '=', 'draft'), '|', ('owner_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_objective_rule_manager" model="ir.rule">
        <field name="name">Objective: team and department objectives</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="domain_force">['|', ('department_id.okr_manager_user_ids', 'in', [user.id]), ('employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_objective_rule_admin" model="ir.rule">
        <field name="name">Objective: all</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="groups" eval="[(4, ref('group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_key_result_rule_user_read" model="ir.rule">
        <field name="name">Key Result: visible key results</field>
        <field name="model_id" ref="model_okr_scale_key_result"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', '|', ('owner_id', '=', user.id), '|', '|', '|', '|', ('objective_id.visibility', '=', 'public'), ('objective_id.owner_id', '=', user.id), ('objective_id.employee_id.user_id', '=', user.id), ('objective_id.key_result_ids.owner_id', '=', user.id), '&amp;', ('objective_id.visibility', '=', 'department'), ('objective_id.department_id.member_ids.user_id', '=', user.id), '|', ('objective_id.department_id.okr_manager_user_ids', 'in', [user.id]), ('objective_id.employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_key_result_rule_user_own" model="ir.rule">
        <field name="name">Key Result: key results of own objectives</field>
        <field name="model_id" ref="model_okr_scale_key_result"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', ('objective_id.owner_id', '=', user.id), ('objective_id.employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_key_result_rule_manager" model="ir.rule">
        <field name="name">Key Result: team and department key results</field>
        <field name="model_id" ref="model_okr_scale_key_result"/>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="domain_force">['|', ('objective_id.department_id.okr_manager_user_ids', 'in', [user.id]), ('objective_id.employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_key_result_rule_admin" model="ir.rule">
        <field name="name">Key Result: all</field>
        <field name="model_id" ref="model_okr_scale_key_result"/>
        <field name="groups" eval="[(4, ref('group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_checkin_rule_user_read" model="ir.rule">
        <field name="name">Check-in: visible check-ins</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), '|', '|', '|', '|', ('objective_id.visibility', '=', 'public'), ('objective_id.owner_id', '=', user.id), ('objective_id.employee_id.user_id', '=', user.id), ('objective_id.key_result_ids.owner_id', '=', user.id), '&amp;', ('objective_id.visibility', '=', 'department'), ('objective_id.department_id.member_ids.user_id', '=', user.id), '|', ('objective_id.department_id.okr_manager_user_ids', 'in', [user.id]), ('objective_id.employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_checkin_rule_user_create" model="ir.rule">
        <field name="name">Check-in: report on own key results</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">['|', '|', ('key_result_id.owner_id', '=', user.id), ('objective_id.owner_id', '=', user.id), ('objective_id.employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_checkin_rule_user_draft" model="ir.rule">
        <field name="name">Check-in: edit own drafts</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_checkin_rule_manager" model="ir.rule">
        <field name="name">Check-in: team and department check-ins</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="domain_force">['|', ('objective_id.department_id.okr_manager_user_ids', 'in', [user.id]), ('objective_id.employee_id.okr_manager_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_checkin_rule_admin" model="ir.rule">
        <field name="name">Check-in: all</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="groups" eval="[(4, ref('group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_cycle_rule_company" model="ir.rule">
        <field name="name">okr.scale.cycle: multi-company</field>
        <field name="model_id" ref="model_okr_scale_cycle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="okr_objective_rule_company" model="ir.rule">
        <field name="name">okr.scale.objective: multi-company</field>
        <field name="model_id" ref="model_okr_scale_objective"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="okr_key_result_rule_company" model="ir.rule">
        <field name="name">okr.scale.key.result: multi-company</field>
        <field name="model_id" ref="model_okr_scale_key_result"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="okr_checkin_rule_company" model="ir.rule">
        <field name="name">okr.scale.checkin: multi-company</field>
        <field name="model_id" ref="model_okr_scale_checkin"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
