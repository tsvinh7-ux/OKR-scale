<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_reward_item_view_kanban" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.kanban</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <kanban class="o_okr_store" create="false" banner_route="/okr_scale_reward/store_banner">
                <field name="id"/>
                <field name="limited_stock"/>
                <field name="can_redeem"/>
                <field name="affordable"/>
                <field name="points_missing"/>
                <field name="user_balance"/>
                <field name="points_cost"/>
                <field name="stock_status"/>
                <field name="available_qty"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_okr_gift {{ record.can_redeem.raw_value ? '' : 'o_okr_gift_locked' }}">
                            <div class="o_okr_gift_media">
                                <img t-att-src="kanban_image('okr.scale.reward.item', 'image_512', record.id.raw_value)"
                                     t-att-alt="record.name.value"/>
                                <span t-attf-class="o_okr_gift_stock o_okr_stock_{{ record.stock_status.raw_value }}">
                                    <t t-if="record.stock_status.raw_value == 'available' or record.stock_status.raw_value == 'low'">
                                        <t t-esc="record.available_qty.value"/> left
                                    </t>
                                    <t t-else="" t-esc="record.stock_status.value"/>
                                </span>
                            </div>
                            <div class="o_okr_gift_body">
                                <div class="o_okr_gift_category" t-if="record.category_id.raw_value">
                                    <t t-esc="record.category_id.value"/>
                                </div>
                                <div class="o_okr_gift_name"><field name="name"/></div>
                                <div class="o_okr_gift_foot">
                                    <span class="o_okr_price_pill">
                                        <i class="fa fa-star" title="Points"/>
                                        <t t-esc="record.points_cost.value"/>
                                        <small>pts</small>
                                    </span>
                                    <button t-if="record.can_redeem.raw_value" name="action_redeem" type="object"
                                            class="btn o_okr_redeem_btn">Redeem</button>
                                    <span t-elif="record.stock_status.raw_value == 'out'" class="o_okr_gift_hint">Out of stock</span>
                                    <span t-else="" class="o_okr_gift_hint">
                                        <i class="fa fa-lock me-1" title="Locked"/><t t-esc="record.points_missing.value"/> pts to go
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="okr_reward_item_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.tree</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="points_cost"/>
                <field name="limited_stock"/>
                <field name="stock_qty" invisible="not limited_stock"/>
                <field name="redemption_count" string="Redemptions"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="okr_reward_item_view_form" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.form</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_redeem" type="object" string="Redeem" class="btn-primary"
                            invisible="not id or not can_redeem"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="okr_scale.group_okr_admin">
                        <button name="action_view_redemptions" type="object" class="oe_stat_button" icon="fa-gift">
                            <field name="redemption_count" widget="statinfo" string="Redemptions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Company hoodie"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="points_cost"/>
                            <field name="category_id"/>
                            <field name="limited_stock"/>
                            <field name="stock_qty" invisible="not limited_stock"/>
                        </group>
                        <group>
                            <field name="product_id" groups="okr_scale.group_okr_admin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                            <field name="user_balance"/>
                            <field name="can_redeem" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the reward..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="okr_reward_item_view_search" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.search</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="in_stock" string="Available" domain="['|', ('limited_stock', '=', False), ('stock_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="okr_reward_item_action_store" model="ir.actions.act_window">
        <field name="name">Reward Store</field>
        <field name="res_model">okr.scale.reward.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{'search_default_in_stock': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The reward store is empty</p>
            <p>OKR administrators add the gifts that employees can get in exchange for their points.</p>
        </field>
    </record>

    <record id="okr_reward_item_action" model="ir.actions.act_window">
        <field name="name">Reward Items</field>
        <field name="res_model">okr.scale.reward.item</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="okr_reward_category_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.reward.category.tree</field>
        <field name="model">okr.scale.reward.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="okr_reward_category_action" model="ir.actions.act_window">
        <field name="name">Reward Categories</field>
        <field name="res_model">okr.scale.reward.category</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
