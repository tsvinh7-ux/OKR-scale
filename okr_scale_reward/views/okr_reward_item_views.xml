<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_reward_item_view_kanban" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.kanban</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_product" create="false">
                <field name="id"/>
                <field name="limited_stock"/>
                <field name="can_redeem"/>
                <field name="user_balance"/>
                <field name="points_cost"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image me-1">
                                <img t-att-src="kanban_image('okr.scale.reward.item', 'image_128', record.id.raw_value)"
                                     alt="Reward" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted small"><field name="category_id"/></div>
                                <div class="mt-1">
                                    <span class="badge text-bg-warning fs-6"><field name="points_cost"/> pts</span>
                                    <span t-if="record.limited_stock.raw_value" class="ms-2 small text-muted">
                                        <field name="stock_qty"/> left
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <button t-if="record.can_redeem.raw_value" name="action_redeem" type="object"
                                            class="btn btn-sm btn-primary">Redeem</button>
                                    <span t-else="" class="small text-muted">
                                        <t t-if="record.limited_stock.raw_value and !record.stock_qty.raw_value">Out of stock</t>
                                        <t t-else="">My points: <t t-esc="record.user_balance.value"/></t>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="okr_reward_item_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.tree</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="points_cost"/>
                <field name="limited_stock"/>
                <field name="stock_qty" invisible="not limited_stock"/>
                <field name="redemption_count" string="Redemptions"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="okr_reward_item_view_form" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.form</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_redeem" type="object" string="Redeem" class="btn-primary"
                            invisible="not id or not can_redeem"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="okr_scale.group_okr_admin">
                        <button name="action_view_redemptions" type="object" class="oe_stat_button" icon="fa-gift">
                            <field name="redemption_count" widget="statinfo" string="Redemptions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Company hoodie"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="points_cost"/>
                            <field name="category_id"/>
                            <field name="limited_stock"/>
                            <field name="stock_qty" invisible="not limited_stock"/>
                        </group>
                        <group>
                            <field name="product_id" groups="okr_scale.group_okr_admin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                            <field name="user_balance"/>
                            <field name="can_redeem" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the reward..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="okr_reward_item_view_search" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.search</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="in_stock" string="Available" domain="['|', ('limited_stock', '=', False), ('stock_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="okr_reward_item_action_store" model="ir.actions.act_window">
        <field name="name">Reward Store</field>
        <field name="res_model">okr.scale.reward.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{'search_default_in_stock': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The reward store is empty</p>
            <p>OKR administrators add the gifts that employees can get in exchange for their points.</p>
        </field>
    </record>

    <record id="okr_reward_item_action" model="ir.actions.act_window">
        <field name="name">Reward Items</field>
        <field name="res_model">okr.scale.reward.item</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="okr_reward_category_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.reward.category.tree</field>
        <field name="model">okr.scale.reward.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="okr_reward_category_action" model="ir.actions.act_window">
        <field name="name">Reward Categories</field>
        <field name="res_model">okr.scale.reward.category</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
