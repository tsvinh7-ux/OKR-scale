#. module: okr_scale_cfr
#: model:okr.scale.core.value,description:okr_scale_cfr.core_value_integrity
msgid "We are honest, transparent and keep our promises."
msgstr "Chúng tôi trung thực, minh bạch và giữ lời hứa."

#. module: okr_scale_cfr
#: model:okr.scale.core.value,description:okr_scale_cfr.core_value_teamwork
msgid "We help each other and win together."
msgstr "Chúng tôi giúp đỡ lẫn nhau và cùng nhau chiến thắng."

#. module: okr_scale_cfr
#: model:okr.scale.core.value,description:okr_scale_cfr.core_value_customer
msgid ""
"We start from the needs of our customers and go the extra mile for them."
msgstr ""
"Chúng tôi bắt đầu từ nhu cầu của khách hàng và luôn nỗ lực hơn nữa vì họ."

#. module: okr_scale_cfr
#: model:okr.scale.core.value,description:okr_scale_cfr.core_value_ownership
msgid "We take responsibility for our results and follow through."
msgstr "Chúng tôi chịu trách nhiệm về kết quả của mình và theo đuổi đến cùng."

#. module: okr_scale_cfr
#: model:okr.scale.core.value,description:okr_scale_cfr.core_value_innovation
msgid "We try new ideas, learn fast and keep improving."
msgstr ""
"Chúng tôi thử nghiệm ý tưởng mới, học hỏi nhanh và không ngừng cải tiến."

#. module: okr_scale_cfr
#. odoo-python
#: code:addons/okr_scale_cfr/models/okr_conversation.py:0
