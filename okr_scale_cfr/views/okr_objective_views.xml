<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_objective_view_form_inherit_cfr" model="ir.ui.view">
        <field name="name">okr.scale.objective.form.inherit.cfr</field>
        <field name="model">okr.scale.objective</field>
        <field name="inherit_id" ref="okr_scale.okr_objective_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_give_kudos" type="object" string="Give Kudos" icon="fa-heart"
                        invisible="state in ('draft', 'cancelled')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_recognitions" type="object" class="oe_stat_button" icon="fa-heart"
                        invisible="not recognition_count">
                    <field name="recognition_count" widget="statinfo" string="Kudos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
