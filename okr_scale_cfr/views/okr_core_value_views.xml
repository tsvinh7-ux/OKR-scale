<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_core_value_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.core.value.tree</field>
        <field name="model">okr.scale.core.value</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
                <field name="recognition_count" string="Recognitions"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="okr_core_value_view_search" model="ir.ui.view">
        <field name="name">okr.scale.core.value.search</field>
        <field name="model">okr.scale.core.value</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="okr_core_value_action" model="ir.actions.act_window">
        <field name="name">Core Values</field>
        <field name="res_model">okr.scale.core.value</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the core values of your company</p>
            <p>Recognitions are tagged with the core values they illustrate.</p>
        </field>
    </record>
</odoo>
