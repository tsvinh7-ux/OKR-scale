<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_conversation_view_tree" model="ir.ui.view">
        <field name="name">okr.scale.conversation.tree</field>
        <field name="model">okr.scale.conversation</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'" decoration-info="state == 'planned'">
                <field name="date"/>
                <field name="name"/>
                <field name="manager_id" widget="many2one_avatar_user"/>
                <field name="employee_user_id" widget="many2one_avatar_user"/>
                <field name="objective_ids" widget="many2many_tags" optional="show"/>
                <field name="cadence" optional="show"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'planned'" decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="okr_conversation_view_form" model="ir.ui.view">
        <field name="name">okr.scale.conversation.form</field>
        <field name="model">okr.scale.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule_meeting" type="object" string="Schedule in Calendar" class="btn-primary"
                            invisible="not id or state != 'planned' or calendar_event_id"/>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'"/>
                    <button name="action_plan" type="object" string="Reset to Planned" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-bullseye" disabled="1">
                            <field name="checkin_count" widget="statinfo" string="Check-ins"/>
                        </button>
                        <button name="action_schedule_meeting" type="object" class="oe_stat_button" icon="fa-calendar"
                                invisible="not calendar_event_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Meeting</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Weekly 1:1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manager_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <field name="employee_user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <field name="objective_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="duration" widget="float_time"/>
                            <field name="cadence"/>
                            <field name="previous_id" invisible="not previous_id"/>
                            <field name="checkin_id" invisible="not checkin_id"/>
                            <field name="calendar_event_id" invisible="not calendar_event_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="okr" string="OKR Snapshot">
                            <field name="key_result_ids" readonly="1" nolabel="1">
                                <tree decoration-danger="status == 'off_track'" decoration-warning="status == 'at_risk'">
                                    <field name="name"/>
                                    <field name="objective_id"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="confidence"/>
                                    <field name="last_checkin_date"/>
                                    <field name="status" widget="badge" decoration-success="status in ('on_track', 'achieved')"
                                           decoration-warning="status == 'at_risk'" decoration-danger="status == 'off_track'"/>
                                </tree>
                            </field>
                        </page>
                        <page name="checkins" string="Check-ins since last 1:1">
                            <div class="text-muted small mb-2">Since <field name="since_date" class="d-inline"/></div>
                            <field name="checkin_ids" readonly="1" nolabel="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="key_result_id"/>
                                    <field name="progress_before" string="Before"/>
                                    <field name="progress_after" widget="progressbar"/>
                                    <field name="confidence"/>
                                    <field name="achievements" optional="show"/>
                                    <field name="blockers"/>
                                    <field name="next_steps" optional="show"/>
                                </tree>
                            </field>
                        </page>
                        <page name="agenda" string="Agenda">
                            <field name="agenda"/>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="What was discussed..."/>
                        </page>
                        <page name="action_items" string="Action Items">
                            <field name="action_items" placeholder="Who does what, by when..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="okr_conversation_view_calendar" model="ir.ui.view">
        <field name="name">okr.scale.conversation.calendar</field>
        <field name="model">okr.scale.conversation</field>
        <field name="arch" type="xml">
            <calendar date_start="date" date_delay="duration" color="employee_user_id" mode="week" quick_create="0">
                <field name="manager_id" avatar_field="avatar_128"/>
                <field name="employee_user_id" avatar_field="avatar_128"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="okr_conversation_view_search" model="ir.ui.view">
        <field name="name">okr.scale.conversation.search</field>
        <field name="model">okr.scale.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="employee_user_id"/>
                <field name="objective_ids"/>
                <filter name="as_manager" string="I lead" domain="[('manager_id', '=', uid)]"/>
                <filter name="as_employee" string="About me" domain="[('employee_user_id', '=', uid)]"/>
                <separator/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_user_id'}"/>
                    <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="okr_conversation_action" model="ir.actions.act_window">
        <field name="name">1:1 Conversations</field>
        <field name="res_model">okr.scale.conversation</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="context">{'search_default_planned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan your first 1:1 conversation</p>
            <p>Regular conversations between managers and team members keep OKRs alive:
                review progress, remove blockers and talk about development.</p>
        </field>
    </record>
</odoo>
