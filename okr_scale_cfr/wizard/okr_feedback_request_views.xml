<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_feedback_request_view_form" model="ir.ui.view">
        <field name="name">okr.scale.feedback.request.form</field>
        <field name="model">okr.scale.feedback.request</field>
        <field name="arch" type="xml">
            <form>
                <div class="o_okr_form_intro">
                    <span class="o_okr_form_intro_icon"><i class="fa fa-comments-o" title="Request"/></span>
                    <div>
                        <h3>Ask for feedback</h3>
                        <p>Each person receives an activity to answer. Ask a precise question to get useful answers.</p>
                    </div>
                </div>
                <group>
                    <group>
                        <field name="giver_ids" widget="many2many_avatar_user" options="{'no_create': True}"/>
                        <field name="recipient_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                        <field name="feedback_type"/>
                    </group>
                    <group>
                        <field name="objective_id" options="{'no_create': True}"/>
                        <field name="key_result_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="message" placeholder="e.g. How did I handle the customer presentation last week?"/>
                <footer>
                    <button name="action_request" type="object" string="Send Request" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="okr_feedback_request_action" model="ir.actions.act_window">
        <field name="name">Request Feedback</field>
        <field name="res_model">okr.scale.feedback.request</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
