<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_recognition_rule_user_read" model="ir.rule">
        <field name="name">Recognition: public or own recognitions</field>
        <field name="model_id" ref="model_okr_scale_recognition"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">['|', '|', ('visibility', '=', 'public'), ('sender_id', '=', user.id), ('receiver_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_recognition_rule_user_own" model="ir.rule">
        <field name="name">Recognition: sender manages own recognitions</field>
        <field name="model_id" ref="model_okr_scale_recognition"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">[('sender_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_recognition_rule_admin" model="ir.rule">
        <field name="name">Recognition: all</field>
        <field name="model_id" ref="model_okr_scale_recognition"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_feedback_rule_user_read" model="ir.rule">
        <field name="name">Feedback: author, recipient and requester</field>
        <field name="model_id" ref="model_okr_scale_feedback"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">['|', '|', ('author_id', '=', user.id), ('recipient_id', '=', user.id), ('requested_by_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_feedback_rule_user_write" model="ir.rule">
        <field name="name">Feedback: author edits until given</field>
        <field name="model_id" ref="model_okr_scale_feedback"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">[('author_id', '=', user.id), ('state', 'in', ('draft', 'requested'))]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_feedback_rule_user_unlink" model="ir.rule">
        <field name="name">Feedback: delete own drafts and own requests</field>
        <field name="model_id" ref="model_okr_scale_feedback"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">['|', '&amp;', ('author_id', '=', user.id), ('state', '=', 'draft'), '&amp;', ('requested_by_id', '=', user.id), ('state', '=', 'requested')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_feedback_rule_admin" model="ir.rule">
        <field name="name">Feedback: all</field>
        <field name="model_id" ref="model_okr_scale_feedback"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_conversation_rule_user" model="ir.rule">
        <field name="name">Conversation: participants</field>
        <field name="model_id" ref="model_okr_scale_conversation"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_user'))]"/>
        <field name="domain_force">['|', ('manager_id', '=', user.id), ('employee_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="okr_conversation_rule_manager" model="ir.rule">
        <field name="name">Conversation: managers organize own conversations</field>
        <field name="model_id" ref="model_okr_scale_conversation"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_manager'))]"/>
        <field name="domain_force">['|', ('manager_id', '=', user.id), ('employee_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_conversation_rule_admin" model="ir.rule">
        <field name="name">Conversation: all</field>
        <field name="model_id" ref="model_okr_scale_conversation"/>
        <field name="groups" eval="[(4, ref('okr_scale.group_okr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="okr_recognition_rule_company" model="ir.rule">
        <field name="name">okr.scale.recognition: multi-company</field>
        <field name="model_id" ref="model_okr_scale_recognition"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="okr_feedback_rule_company" model="ir.rule">
        <field name="name">okr.scale.feedback: multi-company</field>
        <field name="model_id" ref="model_okr_scale_feedback"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="okr_conversation_rule_company" model="ir.rule">
        <field name="name">okr.scale.conversation: multi-company</field>
        <field name="model_id" ref="model_okr_scale_conversation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
