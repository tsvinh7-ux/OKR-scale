<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_activity_okr_mid_review" model="mail.activity.type">
            <field name="name">OKR Mid-cycle Review</field>
            <field name="summary">Mid-cycle review</field>
            <field name="icon">fa-balance-scale</field>
            <field name="delay_count">7</field>
            <field name="res_model">okr.scale.cycle</field>
        </record>

        <record id="mail_activity_okr_final_review" model="mail.activity.type">
            <field name="name">OKR Final Review</field>
            <field name="summary">End-of-cycle retrospective</field>
            <field name="icon">fa-flag-checkered</field>
            <field name="delay_count">7</field>
            <field name="res_model">okr.scale.cycle</field>
        </record>

        <record id="ir_cron_okr_review_reminder" model="ir.cron">
            <field name="name">OKR: cycle review reminders</field>
            <field name="model_id" ref="okr_scale.model_okr_scale_cycle"/>
            <field name="state">code</field>
            <field name="code">model._cron_review_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
