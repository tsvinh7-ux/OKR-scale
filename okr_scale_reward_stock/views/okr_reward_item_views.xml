<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="okr_reward_item_view_form_inherit_stock" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.form.inherit.stock</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="inherit_id" ref="okr_scale_reward.okr_reward_item_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_product_stock" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="not track_inventory or not product_id" groups="stock.group_stock_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="inventory_qty" nolabel="1"/></span>
                        <span class="o_stat_text">On Hand</span>
                    </div>
                </button>
            </xpath>
            <field name="limited_stock" position="before">
                <field name="track_inventory"/>
            </field>
            <field name="limited_stock" position="attributes">
                <attribute name="invisible">track_inventory</attribute>
            </field>
            <field name="stock_qty" position="attributes">
                <attribute name="invisible">not limited_stock or track_inventory</attribute>
            </field>
            <field name="stock_qty" position="after">
                <field name="inventory_free_qty" invisible="not track_inventory"/>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="context">{'default_type': 'product', 'default_sale_ok': False}</attribute>
                <attribute name="placeholder">Created automatically when tracked in inventory</attribute>
            </field>
        </field>
    </record>

    <record id="okr_reward_item_view_tree_inherit_stock" model="ir.ui.view">
        <field name="name">okr.scale.reward.item.tree.inherit.stock</field>
        <field name="model">okr.scale.reward.item</field>
        <field name="inherit_id" ref="okr_scale_reward.okr_reward_item_view_tree"/>
        <field name="arch" type="xml">
            <field name="limited_stock" position="before">
                <field name="track_inventory" optional="show"/>
            </field>
            <field name="stock_qty" position="after">
                <field name="inventory_free_qty" invisible="not track_inventory" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
